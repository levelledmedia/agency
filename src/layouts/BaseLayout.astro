---
import PromoModal from '../components/PromoModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pageStyles?: string;
  minimalHeader?: boolean;
  minimalFooter?: boolean;
  hideFooter?: boolean;
  disableLogoLink?: boolean;
  pixelEvent?: string;
}

const {
  title,
  description,
  pageStyles = '',
  minimalHeader = false,
  minimalFooter = false,
  hideFooter = false,
  disableLogoLink = false,
  pixelEvent = 'PageView'
} = Astro.props;
const isDev = import.meta.env.DEV;
const baseUrl = import.meta.env.BASE_URL;
const pixelScript = `
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '1559357305815698');
  fbq('track', ${JSON.stringify(pixelEvent)});
`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <script is:inline set:html={pixelScript}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  {pageStyles && <style set:html={pageStyles} />}
</head>
<body>
  <noscript>
    <img
      height="1"
      width="1"
      style="display:none"
      src={`https://www.facebook.com/tr?id=1559357305815698&ev=${pixelEvent}&noscript=1`}
      alt=""
    />
  </noscript>
  <header class:list={["nav-header", { "nav-header--minimal": minimalHeader }]} id="nav-header">
    <div class:list={["container", "nav-inner", { "nav-inner--minimal": minimalHeader }]}>
      {disableLogoLink ? (
        <span class:list={["nav-logo", { "nav-logo--centered": minimalHeader }]} aria-label="Levelled Media">
          <img src={baseUrl + "logo-lime.png"} alt="Levelled Media" class="nav-logo-icon nav-logo-icon--lime">
          <img src={baseUrl + "logo-dark.png"} alt="Levelled Media" class="nav-logo-icon nav-logo-icon--dark">
        </span>
      ) : (
        <a href="/" class:list={["nav-logo", { "nav-logo--centered": minimalHeader }]}>
          <img src={baseUrl + "logo-lime.png"} alt="Levelled Media" class="nav-logo-icon nav-logo-icon--lime">
          <img src={baseUrl + "logo-dark.png"} alt="Levelled Media" class="nav-logo-icon nav-logo-icon--dark">
        </a>
      )}

      {!minimalHeader && (
        <>
          <div class="nav-right-group">
            <nav class="nav-links" id="nav-links">
              <ul>
                <li><a href="/about">About Us</a></li>
                <li><a href="/pricing">Pricing</a></li>
                <li><a href="/contact">Contact</a></li>
              </ul>
            </nav>

            <div class="nav-actions">
              <a href="/call" class="btn btn-primary btn-nav">Free website</a>
            </div>
          </div>

          <button class="nav-burger" id="nav-burger" aria-label="Toggle menu">
            <span></span><span></span><span></span>
          </button>
        </>
      )}
    </div>
  </header>

  <slot />

  {!hideFooter && (
  <footer class="footer" id="footer">
    <div class:list={["container", "footer-inner", { "footer-inner--minimal": minimalFooter }]}>
      {!minimalFooter && (
        <>
      <div class="footer-brand">
        <a href="/" class="nav-logo footer-logo">
          <img src={baseUrl + "logo-dark.png"} alt="Levelled Media" class="nav-logo-icon">
        </a>
        <p class="footer-tagline">Websites and local SEO for local service businesses that want more booked jobs.</p>
      </div>

      <div class="footer-col">
        <h5 class="footer-col-title">Services</h5>
        <ul>
          <li><a href="/contact">Website Design</a></li>
          <li><a href="/contact">Local SEO</a></li>
          <li><a href="#">Google Business Profile</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 class="footer-col-title">Company</h5>
        <ul>
          <li><a href="/about">About us</a></li>
          <li><a href="#">Careers</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">Press</a></li>
          <li><a href="#">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 class="footer-col-title">Legal</h5>
        <ul>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>

        </>
      )}
    </div>

    <div class="subfooter">
      <div class:list={["container", "subfooter-inner", { "subfooter-inner--minimal": minimalFooter }]}>
        <p class="subfooter-copy">© 2026 Levelled Media. All rights reserved.</p>
      </div>
    </div>
  </footer>
  )}

  <PromoModal />
  <script src="../scripts/main.js"></script>
</body>
</html>
