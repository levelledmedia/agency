---
import PromoModal from '../components/PromoModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pageStyles?: string;
}

const { title, description, pageStyles = '' } = Astro.props;
const isDev = import.meta.env.DEV;
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  {pageStyles && <style set:html={pageStyles} />}
</head>
<body>
  <header class="nav-header" id="nav-header">
    <div class="container nav-inner">
      <a href={baseUrl + "/"} class="nav-logo">
        <img src={baseUrl + "/logo-lime.png"} alt="Levelled Media" class="nav-logo-icon nav-logo-icon--lime">
        <img src={baseUrl + "/logo-dark.png"} alt="Levelled Media" class="nav-logo-icon nav-logo-icon--dark">
      </a>

      <nav class="nav-links" id="nav-links">
        <ul>
          {isDev && <li><a href="/about">Company</a></li>}
          {isDev && <li><a href="/pricing">Pricing</a></li>}
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="/contact" class="btn btn-ghost btn-nav">Contact</a>
        <button class="btn btn-primary btn-nav" id="promo-modal-open">Free website</button>
      </div>

      <button class="nav-burger" id="nav-burger" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <slot />

  <footer class="footer" id="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href={baseUrl + "/"} class="nav-logo footer-logo">
          <img src={baseUrl + "/logo-dark.png"} alt="Levelled Media" class="nav-logo-icon">
        </a>
        <p class="footer-tagline">Websites and local SEO for home service businesses that want more booked jobs.</p>
      </div>

      <div class="footer-col">
        <h5 class="footer-col-title">Services</h5>
        <ul>
          <li><a href="/contact">Website Design</a></li>
          <li><a href="/contact">Local SEO</a></li>
          <li><a href="#">Google Business Profile</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 class="footer-col-title">Company</h5>
        <ul>
          <li><a href="/about">About us</a></li>
          <li><a href="#">Careers</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">Press</a></li>
          <li><a href="#">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5 class="footer-col-title">Legal</h5>
        <ul>
          <li><a href="#">Privacy Policy</a></li>
          <li><a href="#">Terms of Service</a></li>
          <li><a href="#">Cookie Policy</a></li>
          <li><a href="#">Licences</a></li>
        </ul>
      </div>

      <div class="footer-socials">
        <h5 class="footer-col-title">Follow Us</h5>

        <div class="footer-social-group">
          <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="Twitter/X">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.259 5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>

          <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 3.667h-3.533v7.98H9.101z" />
            </svg>
          </a>

          <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
            </svg>
          </a>

          <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="subfooter">
      <div class="container subfooter-inner">
        <p class="subfooter-copy">© 2026 Levelled Media. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <PromoModal />
  <script src="../scripts/main.js"></script>
</body>
</html>
