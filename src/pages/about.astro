---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
const baseUrl = import.meta.env.BASE_URL;
const title = "About Us - Levelled Media";
const description = "Levelled Media helps local businesses improve the way they attract, manage and convert enquiries using modern websites, automation, AI and local search.";
const pageStyles = `
    @import url('https://fonts.googleapis.com/css2?family=Mrs+Saint+Delafield&display=swap');

    /* ---- What we believe — carried over from about.astro (page-scoped, not global) ---- */
    .mission-section {
      background: var(--white);
      padding: var(--section-py) 0;
    }

    #our-mission { padding-bottom: 40px; }
    #team { padding-top: 88px; }

    .mission-header {
      text-align: center;
      margin-bottom: 56px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .mission-header .eyebrow {
      display: block;
    }

    .mission-content-wrapper {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .mission-statement {
      font-size: 20px;
      line-height: 1.6;
      color: var(--body-text);
      margin: 0;
      text-align: center;
    }

    /* ---- Company 2 page — team section, now a single founder profile ---- */
    .team-section { background: var(--white); padding: var(--section-py) 0; }

    .section-divider {
      width: 64px;
      height: 1px;
      background: rgba(0, 33, 43, 0.15);
      margin: 0 auto 64px;
    }

    .founder-profile {
      display: grid;
      grid-template-columns: 400px 1fr;
      gap: 80px;
      align-items: center;
      max-width: 980px;
      margin: 0 auto;
    }

    .founder-profile-photo {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .founder-profile-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .founder-profile-name {
      font-size: 22px;
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 4px;
    }

    .founder-profile-role {
      font-size: 15px;
      color: var(--body-text);
      margin-bottom: 20px;
    }

    .founder-profile-bio p {
      font-size: 16px;
      line-height: 1.6;
      color: var(--body-text);
      margin: 0 0 16px;
    }

    .founder-profile-bio p:last-child { margin-bottom: 0; }

    /* ---- Mini stats strip, inside the dark "Our approach" card ---- */
    .mini-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: 32px;
      padding-top: 28px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .mini-stat-number {
      font-size: 30px;
      font-weight: 600;
      color: var(--green);
      letter-spacing: -0.01em;
      line-height: 1;
      margin-bottom: 6px;
    }

    .mini-stat-label {
      font-size: 13px;
      color: var(--white-muted);
      line-height: 1.4;
    }

    @media (max-width: 1024px) {
      .mini-stats { grid-template-columns: repeat(2, 1fr); row-gap: 20px; }
    }

    .founder-signature {
      font-family: 'Mrs Saint Delafield', cursive;
      font-size: 46px;
      line-height: 1;
      color: var(--dark);
      margin-top: 20px;
      transform: rotate(-2deg);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .founder-profile { grid-template-columns: 1fr; text-align: center; }
      .founder-profile-photo { max-width: 240px; margin: 0 auto; }
    }
`;
---

<BaseLayout title={title} description={description} pageStyles={pageStyles}>
  <!-- ============================================================
       HERO — ABOUT
  ============================================================ -->
  <section class="hero-section hero-section--compact" id="hero">
    <div class="container">
      <div class="hero-inner" style="align-items: center; text-align: center;">

        <div class="hero-badge fade-up">
          <span class="badge-dot"></span>
          Our story
        </div>

        <h1 class="hero-title fade-up">We help local service businesses win online</h1>

        <p class="hero-subtitle fade-up" style="max-width: 680px; margin-left: auto; margin-right: auto;">
          Levelled Media is a specialist agency focused entirely on local businesses. We build modern websites,
          automation and local search systems that help you attract, manage and convert more enquiries.
        </p>

        <div class="hero-ctas fade-up">
          <a href="#" class="btn btn-primary btn-lg" id="promo-modal-open">Get a free website</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHY WE EXIST — light detail block, no CTA button
  ============================================================ -->
  <section class="detail-section" id="mission">
    <div class="detail-block detail-block--light">
      <div class="container detail-inner">
        <div class="detail-content fade-up">
          <p class="eyebrow">Why we exist</p>
          <h2 class="section-title">Where opportunities slip through the cracks</h2>
          <p class="detail-body">A lot of local businesses are excellent at the work they actually get paid to do.
            The problem is everything around it: calls get missed, enquiries sit unanswered, quotes are never
            followed up, old leads disappear into WhatsApp threads and spreadsheets, review requests get forgotten,
            and websites look dated, load slowly or give visitors no clear reason to get in touch.</p>
          <p class="detail-body">We started Levelled Media because we saw how common this was. The technology to fix
            these problems already exists. What's traditionally been missing is a practical, affordable way for
            smaller businesses to actually use it. That is the gap we are here to close.</p>
        </div>
        <div class="detail-visual fade-up">
          <div class="img-placeholder img-placeholder--detail" style="height: 520px;">
            <span>Missed calls, unanswered enquiries and forgotten follow-ups add up</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       OUR APPROACH — dark card, image left / content right
       (was: COMPANY STATS strip)
  ============================================================ -->
  <section class="detail-section" id="stats">
    <div class="detail-block detail-block--green-card">
      <div class="container detail-inner">
        <div class="detail-visual fade-up">
          <div class="img-placeholder img-placeholder--on-dark" style="height: 480px;">
            <span>Front end and back end, built together</span>
          </div>
        </div>
        <div class="detail-content fade-up">
          <p class="eyebrow">Our approach</p>
          <h2 class="section-title">Marketing should make life easier</h2>
          <p class="detail-body">Marketing shouldn't become another full-time job. It should help the right people
            find you, make it easy for them to take the next step, and give your business a reliable process for
            handling what happens next.</p>
          <p class="detail-body">A website can generate an enquiry, but what happens if nobody replies, a call is
            missed, or an old prospect is finally ready to buy six months later? Those small gaps add up. So we
            build the front end and the back end together: the website creates demand and captures enquiries, while
            the systems behind it help you respond, follow up and recover opportunities that would otherwise
            disappear. That is what makes the difference.</p>

          <div class="mini-stats">
            <div>
              <div class="mini-stat-number">50+</div>
              <div class="mini-stat-label">Clients helped across the UK</div>
            </div>
            <div>
              <div class="mini-stat-number">500+</div>
              <div class="mini-stat-label">Local keywords ranked on page one</div>
            </div>
            <div>
              <div class="mini-stat-number">120+</div>
              <div class="mini-stat-label">Projects completed</div>
            </div>
            <div>
              <div class="mini-stat-number">98%</div>
              <div class="mini-stat-label">Client retention rate</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       WHAT DRIVES US
  ============================================================ -->
  <section class="mission-section" id="our-mission">
    <div class="container">
      <div class="mission-header fade-up">
        <p class="eyebrow">What we believe</p>
        <h2 class="section-title">Better systems, less busywork</h2>
      </div>

      <div class="mission-content-wrapper fade-up">
        <p class="mission-statement">
          There's a lot of nonsense in marketing: tactics recycled because they work just well enough, and agencies
          piling on services without fixing the real problem. We'd rather keep it simple: find where opportunities
          are being lost, fix the biggest gaps, and automate the rest.
        </p>
        <p class="mission-statement">
          We're constantly testing and refining what we use, and once something works, we standardise it for every
          client. The goal isn't chasing trends. It's staying focused on what matters: more of the right enquiries,
          better conversion, more revenue.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TEAM — now a single founder profile instead of 3 cards
  ============================================================ -->
  <section class="team-section" id="team">
    <div class="container">

      <div class="section-divider fade-up"></div>

      <div class="founder-profile fade-up">
        <div class="founder-profile-photo">
          <img src={baseUrl + "team/lewis-founder.jpg"} alt="Lewis, Founder of Levelled Media">
        </div>
        <div>
          <p class="founder-profile-name">Meet Lewis</p>
          <p class="founder-profile-role">Founder, Levelled Media</p>
          <div class="founder-profile-bio">
            <p>I started Levelled Media because marketing, sales and business have always fascinated me. What
              interests me most is the system behind the result: working out which lever matters most right now,
              improving it, then moving onto the next.</p>
            <p>A business has dozens of different levers: lead generation, conversion, follow-up, customer
              experience, pricing, retention, reviews and communication. That's how I approach every client's
              business, and it's the same thinking behind everything we build.</p>
            <p>I'm constantly learning, testing and refining the systems we use, and once something consistently
              works, we turn it into a repeatable process the wider team can put to work for every client. If
              something can be automated, simplified or improved, I want to find out how.</p>
          </div>
          <p class="founder-signature">Lewis Parrott</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================================
       TESTIMONIALS — soft bg, 2-column card layout
  ============================================================ -->
  <TestimonialsSection />

  <!-- ============================================================
       COMPANY FAQ
  ============================================================ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-inner fade-up">
        <div class="faq-content">
          <p class="eyebrow">Got questions?</p>
          <h2 class="section-title">Questions &amp; Answers</h2>
          <p class="faq-sub">Everything you need to know about who we are, how we work, and what it's like to be a client. Can't find what you're looking for? Just reach out.</p>
          <a href="/contact" class="btn btn-secondary">Contact Us</a>
        </div>

        <div class="faq-list">
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do you only work with home service businesses?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. A lot of our clients and prospects are trades and home service businesses, but the real
              requirement is simpler: you are a local business that relies on enquiries, appointments or sales
              conversations to generate revenue. If better lead handling, follow-up, online visibility and customer
              communication could improve your business, there is a good chance we can help.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Who is Levelled Media a good fit for?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We're not the right fit for everyone. If the only goal is to spend as little as possible and keep
              doing things the same way, there are cheaper options out there. We work best with business owners who
              understand that better systems, marketing and customer experience are investments, not expenses. You
              don't need to be a huge company, you just need to be willing to improve.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Are you a website agency?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes, but that only tells part of the story. We build professional, conversion-focused websites, but we
              are much more interested in what happens before and after someone lands on the site. Our broader
              system can help capture enquiries, respond to leads, recover missed calls, follow up prospects,
              request reviews, manage appointments and track opportunities. The website is the front door. We care
              about the rest of the building too.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Can you guarantee more leads or revenue?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. There are too many variables involved in marketing, sales and running a business for anyone to
              responsibly guarantee a specific number. What we can do is improve the systems that influence those
              outcomes. We can help you become easier to find, easier to contact, faster to respond and more
              consistent in the way you follow up and communicate.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do I need to understand all the technology?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. In fact, that is partly the point. We set things up so you can benefit from modern automation and
              AI without becoming a software expert yourself. We try to keep the system simple, practical and as
              hands-off as possible.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              How hands-on do I need to be?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              As little as you want. Levelled Media is deliberately lean, and we'd rather work closely with you and
              build systems around your real problems than pass you between account managers who barely know your
              name. We keep the process as hands-off as possible: you get direct communication and practical advice,
              and our job is to remove work from your plate, not add to it.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What if I already have a website?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              That is fine. If the existing website is worth keeping, we can look at the wider marketing and sales
              system around it. If it is outdated, difficult to use or not converting well, we can replace it. The
              goal is not to rebuild things unnecessarily. The goal is to improve what is actually holding the
              business back.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What makes you different from another marketing agency?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We are less interested in selling isolated marketing services and more interested in improving the
              whole journey from discovery to sale. Generating attention is only part of the job. You also need to
              capture it, respond to it, follow it up and turn it into revenue. That is where a lot of businesses
              lose money, and it is where we put a lot of our attention.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       PRE-FOOTER CTA
  ============================================================ -->
  <section class="final-cta-section">
    <div class="container text-center fade-up">
      <h2 class="section-title">Ready to win more customers?</h2>
      <p class="final-cta-sub">You don't necessarily need thousands more leads. You might just need a better system
        for handling the opportunities you already have. We'll build the website, technology and follow-up
        infrastructure that helps make that happen.</p>
      <a href="#" class="btn btn-primary btn-xl" id="promo-modal-open">Get your free website</a>
    </div>
  </section>
</BaseLayout>
