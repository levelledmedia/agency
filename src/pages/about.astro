---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
const title = "About Us — Levelled Media";
const description = "Learn about Levelled Media — who we are, what we stand for, and why we focus exclusively on helping home service businesses grow online.";
const pageStyles = `
    /* ---- About page — company stats strip ---- */
    .stats-section {
      background: var(--dark);
      padding: 88px 0;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--gap-lg);
    }

    .stat-item {
      text-align: center;
    }

    .stat-number {
      font-size: 64px;
      font-weight: 500;
      color: var(--green);
      letter-spacing: -0.02em;
      line-height: 1;
      margin-bottom: 12px;
    }

    .stat-label {
      font-size: 16px;
      color: var(--white-muted);
      line-height: 1.4;
    }

    /* ---- About page — what drives us ---- */
    .mission-section {
      background: var(--white);
      padding: var(--section-py) 0;
    }

    .mission-header {
      text-align: center;
      margin-bottom: 56px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .mission-header .eyebrow {
      display: block;
    }

    .mission-content-wrapper {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .mission-statement {
      font-size: 20px;
      line-height: 1.6;
      color: var(--body-text);
      margin: 0;
      text-align: center;
    }

    /* ---- About page — team cards ---- */
    .team-section {
      background: var(--white);
      padding: var(--section-py) 0;
    }

    .team-header {
      text-align: center;
      margin-bottom: 64px;
    }

    .team-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gap-sm);
    }

    .team-card {
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .team-card-photo {
      width: 100%;
      aspect-ratio: 4 / 5;
    }

    .team-card-info {
      padding: 20px 4px;
    }

    .team-card-name {
      font-size: 20px;
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 8px;
    }

    .team-card-role {
      font-size: 15px;
      color: var(--body-text);
      margin-bottom: 16px;
    }

    .team-card-socials {
      display: flex;
      gap: 8px;
    }

    /* ---- About page — 2-col testimonials ---- */
    .about-testimonials-section {
      background: var(--soft-bg);
      padding: var(--section-py) 0;
    }

    .about-testimonials-header {
      text-align: center;
      margin-bottom: 56px;
    }

    .about-testimonials-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gap-sm);
    }

    .about-testimonial-card {
      background: var(--white);
      border-radius: var(--radius-card);
      padding: 40px;
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 28px;
      align-items: start;
    }

    .about-testimonial-photo {
      width: 80px;
      height: 80px;
      min-height: unset;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      font-size: 11px;
      padding: 4px;
    }

    .about-testimonial-body {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .about-testimonial-name {
      font-size: 16px;
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 0;
    }

    .about-testimonial-biz {
      font-size: 14px;
      color: var(--body-text);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 40px; }
      .mission-plaque { padding: 56px 48px; }
      .mission-block { grid-template-columns: 1fr; gap: 48px; }
      .mission-card { padding: 40px 32px; }
    }

    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
      .stat-number { font-size: 48px; }
      .about-testimonials-grid { grid-template-columns: 1fr; }
      .mission-plaque { padding: 40px 32px; max-width: 100%; }
      .team-grid { grid-template-columns: repeat(3, 1fr); }
      .mission-grid { grid-template-columns: 1fr; gap: 32px; }
      .mission-card-v2-inner { padding: 40px 32px; }
      .mission-split-content { padding: 32px; }
      .mission-split-commitment { padding: 32px; }
      .mission-split-quote { font-size: 20px; }
      .mission-card-bordered { padding: 40px 32px; }
    }

    @media (max-width: 480px) {
      .stats-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
      .team-grid { grid-template-columns: 1fr 1fr; }
      .about-testimonial-card { grid-template-columns: 56px 1fr; gap: 16px; padding: 28px; }
      .about-testimonial-photo { width: 56px; height: 56px; }
    }
`;
---

<BaseLayout title={title} description={description} pageStyles={pageStyles}>
  <!-- ============================================================
       HERO — ABOUT
       Uses hero-inner--centered but without the 760px max-width cap.
  ============================================================ -->
  <section class="hero-section hero-section--compact" id="hero">
    <div class="container">
      <div class="hero-inner" style="align-items: center; text-align: center;">

        <div class="hero-badge fade-up">
          <span class="badge-dot"></span>
          Our story
        </div>

        <h1 class="hero-title fade-up">We help trades businesses<br>win online</h1>

        <p class="hero-subtitle fade-up" style="max-width: 680px; margin-left: auto; margin-right: auto;">
          Levelled Media is a specialist digital agency focused entirely on home service businesses. We build websites and local SEO systems that generate consistent inquiries and real booked work.
        </p>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHY WE EXIST — light detail block, no CTA button
  ============================================================ -->
  <section class="detail-section" id="mission">
    <div class="detail-block detail-block--light">
      <div class="container detail-inner">
        <div class="detail-content fade-up">
          <p class="eyebrow">Why we exist</p>
          <h2 class="section-title">Built for trades,<br>not built for everyone</h2>
          <p class="detail-body">Most digital agencies spread themselves thin across every industry. We made a different choice: to go deep on home service businesses and build systems that actually work in competitive local markets. We started Levelled Media because we saw talented tradespeople losing work to competitors with weaker skills but stronger online presence. That didn't sit right with us.</p>
          <p class="detail-body">So we built an agency that does one thing well: helping trades businesses get found, get clicks, and get the phone ringing. No jargon, no runaround, and results you can actually measure.</p>
        </div>
        <div class="detail-visual fade-up">
          <div class="img-placeholder img-placeholder--detail" style="height: 520px;">
            <span>Team working on a website project for a trades client</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       COMPANY STATS — dark strip, 4 columns
  ============================================================ -->
  <section class="stats-section" id="stats">
    <div class="container">
      <div class="stats-grid fade-up">

        <div class="stat-item">
          <div class="stat-number">50+</div>
          <div class="stat-label">Clients helped across the UK</div>
        </div>

        <div class="stat-item">
          <div class="stat-number">500+</div>
          <div class="stat-label">Local keywords ranked on page one</div>
        </div>

        <div class="stat-item">
          <div class="stat-number">120+</div>
          <div class="stat-label">Projects completed</div>
        </div>

        <div class="stat-item">
          <div class="stat-number">98%</div>
          <div class="stat-label">Client retention rate</div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHAT DRIVES US
  ============================================================ -->
  <section class="mission-section" id="our-mission">
    <div class="container">
      <div class="mission-header fade-up">
        <p class="eyebrow">What drives us</p>
        <h2 class="section-title">We believe great work<br>deserves to be found</h2>
      </div>

      <div class="mission-content-wrapper fade-up">
        <p class="mission-statement">
          Too many skilled tradespeople lose work to competitors with flashier websites and better search rankings.
          That's not right. Your reputation should speak louder than someone else's SEO budget.
        </p>
        <p class="mission-statement">
          We started Levelled Media to change that. To give every home service business access to the same tools,
          systems, and expertise that used to cost tens of thousands. No jargon. No lock-ins. Just clear results you can measure.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       TEAM — white bg, 4-column person cards
  ============================================================ -->
  <section class="team-section" id="team">
    <div class="container">

      <div class="team-header fade-up">
        <p class="eyebrow">The team</p>
        <h2 class="section-title">The people behind the work</h2>
      </div>

      <div class="team-grid fade-up">

        <div class="team-card">
          <div class="team-card-photo img-placeholder">
            <span>Photo</span>
          </div>
          <div class="team-card-info">
            <p class="team-card-name">James Whitfield</p>
            <p class="team-card-role">Founder &amp; Strategy</p>
            <div class="team-card-socials">
              <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="LinkedIn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="Twitter/X">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.259 5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="team-card">
          <div class="team-card-photo img-placeholder">
            <span>Photo</span>
          </div>
          <div class="team-card-info">
            <p class="team-card-name">Sara Okafor</p>
            <p class="team-card-role">Lead Designer</p>
            <div class="team-card-socials">
              <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="LinkedIn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="Instagram">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="team-card">
          <div class="team-card-photo img-placeholder">
            <span>Photo</span>
          </div>
          <div class="team-card-info">
            <p class="team-card-name">Tom Hadley</p>
            <p class="team-card-role">SEO Lead</p>
            <div class="team-card-socials">
              <a href="#" class="footer-social-btn footer-social-btn--light" aria-label="LinkedIn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       TESTIMONIALS — soft bg, 2-column card layout
  ============================================================ -->
  <TestimonialsSection />

  <!-- ============================================================
       COMPANY FAQ
  ============================================================ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-inner fade-up">
        <div class="faq-content">
          <p class="eyebrow">Got questions?</p>
          <h2 class="section-title">Questions &amp;<br>Answers</h2>
          <p class="faq-sub">Everything you need to know about who we are, how we work, and what it's like to be a client. Can't find what you're looking for? Just reach out.</p>
          <a href="#" class="btn btn-secondary">Contact Us</a>
        </div>

        <div class="faq-list">
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Who do you work with?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We work exclusively with home service businesses including plumbers, electricians, roofers, HVAC companies, landscapers, and other trades. Our focus on this one sector means we understand your market, your customers, and what it takes to win locally.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Where are you based?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We're based in Essex but work with tradespeople from Scotland to the South Coast. Location is never a barrier, and everything is handled smoothly online.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              How long have you been in business?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We've been building websites and running SEO campaigns for home service businesses for several years. In that time we've helped over 50 clients, completed 120+ projects, and ranked hundreds of local keywords on page one.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What does working with you actually look like?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              After an initial call, we audit your current website and search visibility and put together a clear plan. From there we handle everything (design, build, SEO, and ongoing optimisation) while keeping you informed at every stage with straightforward monthly reporting.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do you take on clients outside the UK?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Our primary focus is the UK market, where we have the deepest knowledge of local search behaviour and competition. That said, we're open to conversations with trades businesses in similar English-speaking markets. Just get in touch.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       PRE-FOOTER CTA
  ============================================================ -->
  <section class="final-cta-section">
    <div class="container text-center fade-up">
      <h2 class="section-title">Ready to grow your<br>trades business online?</h2>
      <p class="final-cta-sub">Get your free website and start generating more local inquiries today.</p>
      <a href="#" class="btn btn-primary btn-xl">Get a free website</a>
    </div>
  </section>
</BaseLayout>
