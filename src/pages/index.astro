---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import TestimonialsSectionVideo from '../components/TestimonialsSectionVideo.astro';

const baseUrl = import.meta.env.BASE_URL;

const pageStyles = `
    /* Programmatic UI Graphics & Animations */
    .ui-graphic {
      width: 100%;
      height: 100%;
      min-height: 380px;
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
      box-shadow: none;
      border: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 1. Bad Website / Lost Conversion Graphic */
    .ui-bad-website {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 480px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #cbd5e1;
      background: #f1f5f9;
      box-shadow: none;
      display: flex;
      flex-direction: column;
    }

    .ui-browser-bar {
      height: 36px;
      background: #e2e8f0;
      display: flex;
      align-items: center;
      padding: 0 16px;
      gap: 8px;
      border-bottom: 1px solid #cbd5e1;
    }

    .ui-browser-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #cbd5e1;
    }

    .ui-browser-dot:nth-child(1) {
      background: #ef4444;
    }

    /* Close btn acting somewhat like mac */
    .ui-browser-dot:nth-child(2) {
      background: #eab308;
    }

    .ui-browser-dot:nth-child(3) {
      background: #22c55e;
    }

    .ui-bad-nav {
      height: 60px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      background: #fff;
      border-bottom: 2px dashed #e2e8f0;
    }

    .ui-bad-logo {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #94a3b8;
    }

    .ui-bad-links {
      margin-left: auto;
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .ui-bad-link {
      width: 40px;
      height: 8px;
      border-radius: 4px;
      background: #cbd5e1;
    }

    .ui-bad-cta {
      width: 60px;
      height: 24px;
      border-radius: 4px;
      background: #94a3b8;
      opacity: 0.5;
    }

    .ui-bad-hero {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px;
      gap: 20px;
      text-align: center;
    }

    .ui-bad-h1 {
      width: 90%;
      max-width: 400px;
      height: 32px;
      background: #64748b;
      border-radius: 8px;
      margin-bottom: 12px;
    }

    .ui-bad-p {
      width: 100%;
      max-width: 300px;
      height: 12px;
      background: #cbd5e1;
      border-radius: 6px;
    }

    .ui-bad-p.short {
      width: 70%;
    }

    .ui-bad-btn-lost {
      margin-top: 32px;
      width: 120px;
      height: 48px;
      background: #e2e8f0;
      border-radius: 6px;
      border: 2px dotted #94a3b8;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Confused Cursor Animation */
    .ui-cursor {
      position: absolute;
      width: 24px;
      height: 24px;
      z-index: 50;
      animation: cursorWander 8s infinite cubic-bezier(0.4, 0, 0.2, 1);
      filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.2));
    }

    .ui-cursor svg {
      width: 100%;
      height: 100%;
    }

    .ui-bounce-tag {
      position: absolute;
      top: 45px;
      left: 20px;
      background: #ef4444;
      color: #fff;
      font-size: 11px;
      font-weight: bold;
      padding: 6px 12px;
      border-radius: 16px;
      text-transform: uppercase;
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
      opacity: 0;
      transform: scale(0.8) translateY(10px);
      animation: showBounce 8s infinite;
      z-index: 40;
    }

    @keyframes cursorWander {
      0% {
        top: 60%;
        left: 80%;
        opacity: 0;
        transform: scale(1.5);
      }

      5% {
        top: 60%;
        left: 80%;
        opacity: 1;
        transform: scale(1);
      }

      20% {
        top: 65%;
        left: 50%;
      }

      /* Looks at CTA */
      35% {
        top: 30%;
        left: 60%;
      }

      /* Wanders up */
      50% {
        top: 40%;
        left: 30%;
      }

      /* Wanders left */
      70% {
        top: 15px;
        left: 15px;
      }

      /* Heads to close tab button */
      75% {
        top: 15px;
        left: 15px;
        transform: scale(0.9);
      }

      /* Click press */
      80% {
        top: 15px;
        left: 15px;
        transform: scale(1);
        opacity: 1;
      }

      85% {
        top: 15px;
        left: 15px;
        opacity: 0;
      }

      100% {
        top: 60%;
        left: 80%;
        opacity: 0;
      }
    }

    @keyframes showBounce {

      0%,
      75% {
        opacity: 0;
        transform: scale(0.8) translateY(10px);
      }

      80% {
        opacity: 1;
        transform: scale(1.1) translateY(0);
      }

      85% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }

      95% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }

      100% {
        opacity: 0;
        transform: scale(0.8) translateY(-10px);
      }
    }

    /* 2. Enhanced Local SEO Animation (GBP Cards) */
    .ui-gbp-container {
      position: relative;
      width: 100%;
      min-height: 480px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: transparent;
      padding: 0 16px;
      box-sizing: border-box;
    }

    .ui-gbp-track {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
      max-width: 460px;
      position: relative;
    }

    .ui-gbp-card {
      width: 100%;
      height: 100px;
      box-sizing: border-box;
      background: white;
      border-radius: 16px;
      padding: 20px 24px;
      box-shadow: none;
      display: flex;
      align-items: center;
      gap: 20px;
      border: 1px solid #e2e8f0;
      position: relative;
      z-index: 1;
      animation: gbpShiftDown 8s infinite cubic-bezier(0.25, 1, 0.5, 1);
    }

    .ui-gbp-card.is-target {
      box-shadow: none;
      z-index: 10;
      animation: gbpClimbUp 8s infinite cubic-bezier(0.25, 1, 0.5, 1);
    }

    .ui-gbp-badge {
      position: absolute;
      top: -12px;
      right: -12px;
      background: var(--green);
      color: var(--dark);
      font-size: 13px;
      font-weight: 700;
      padding: 6px 16px;
      border-radius: 12px;
      box-shadow: none;
    }

    .agbp-avatar {
      width: 56px;
      height: 56px;
      border-radius: 8px;
      background: #e2e8f0;
      flex-shrink: 0;
    }

    .ui-gbp-card.is-target .agbp-avatar {
      background: var(--dark);
    }

    .agbp-info {
      flex: 1;
    }

    .agbp-name {
      height: 16px;
      width: 60%;
      background: #94a3b8;
      border-radius: 4px;
      margin-bottom: 10px;
    }

    .ui-gbp-card.is-target .agbp-name {
      background: var(--dark);
      width: 75%;
    }

    .agbp-meta {
      display: flex;
      gap: 4px;
      align-items: center;
      margin-bottom: 8px;
    }

    .agbp-star {
      color: #fbbf24;
      font-size: 14px;
    }

    .agbp-rating {
      width: 48px;
      height: 8px;
      background: #e2e8f0;
      border-radius: 4px;
      margin-left: 8px;
    }

    .agbp-desc {
      height: 8px;
      width: 45%;
      background: #f1f5f9;
      border-radius: 4px;
    }

    /* Target climbs 3 slots (3 * 120px) */
    @keyframes gbpClimbUp {

      0%,
      15% {
        transform: translateY(0) scale(1);
      }

      30%,
      85% {
        transform: translateY(-360px) scale(1.05);
      }

      95%,
      100% {
        transform: translateY(0) scale(1);
      }
    }

    /* Competitors shift down 1 slot (1 * 120px) */
    @keyframes gbpShiftDown {

      0%,
      15% {
        transform: translateY(0);
      }

      30%,
      85% {
        transform: translateY(120px);
      }

      95%,
      100% {
        transform: translateY(0);
      }
    }

    /* AI Receptionist Animation (Chat UI inside Phone) */
    .ui-phone {
      margin: 0 auto;
      max-width: 320px;
      height: 100%;
      min-height: 540px;
      border-radius: 32px;
      overflow: hidden;
      border: 8px solid #cbd5e1;
      background: #f8fafc;
      box-shadow: none;
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .ui-phone-notch-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: center;
      z-index: 20;
    }

    .ui-phone-notch {
      width: 130px;
      height: 24px;
      background: #cbd5e1;
      border-bottom-left-radius: 12px;
      border-bottom-right-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ui-phone-speaker {
      width: 48px;
      height: 4px;
      background: #94a3b8;
      border-radius: 2px;
    }

    .ui-chat-container {
      width: 100%;
      height: 100%;
      max-width: 500px;
      margin: 0 auto;
      padding: 24px 16px 40px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      justify-content: center;
      position: relative;
    }
    
    .ui-phone .ui-chat-container {
      max-width: none;
      padding: 40px 16px 24px 16px;
    }

    .ui-sys-msg {
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      color: #ef4444;
      background: #fef2f2;
      border: 1px solid #fecaca;
      padding: 6px 16px;
      border-radius: 16px;
      margin-bottom: 4px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      align-self: center;
      animation: fadeInMsg 24s infinite;
    }
    
    .ui-phone .ui-sys-msg {
      font-size: 11px;
      padding: 6px 14px;
    }

    .ui-chat-bubble {
      padding: 16px 20px;
      border-radius: 20px;
      font-size: 16px;
      line-height: 1.5;
      max-width: 85%;
      opacity: 0;
      transform: translateY(10px);
    }
    
    .ui-phone .ui-chat-bubble {
      font-size: 14px;
      padding: 12px 16px;
    }
    
    .ui-chat-ai-header {
      font-size: 12px; 
      opacity: 0.9; 
      margin-bottom: 6px; 
      font-weight: 700; 
      display: flex; 
      align-items: center; 
      gap: 4px;
    }
    
    .ui-phone .ui-chat-ai-header {
      font-size: 11px;
      margin-bottom: 4px;
    }

    .ui-chat-ai {
      background: var(--dark, #002C15);
      color: white;
      align-self: flex-start;
      border-bottom-left-radius: 4px;
      animation: popInAI 24s infinite;
    }

    .ui-chat-user {
      background: #e2e8f0;
      color: #334155;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
      animation: popInUser 24s infinite;
    }

    .ui-typing-indicator {
      display: flex;
      gap: 4px;
      padding: 14px 18px;
      background: var(--dark, #002C15);
      border-radius: 20px;
      border-bottom-left-radius: 4px;
      align-self: flex-start;
      width: fit-content;
      opacity: 0;
      animation: typeIndicator 24s infinite;
    }

    .ui-typing-indicator-1 {
      animation: typeIndicator1 24s infinite;
    }

    .ui-typing-dot {
      width: 6px;
      height: 6px;
      background: #94a3b8;
      border-radius: 50%;
      animation: typePulse 1.4s infinite ease-in-out;
    }

    .ui-typing-dot:nth-child(1) {
      animation-delay: 0s;
    }

    .ui-typing-dot:nth-child(2) {
      animation-delay: 0.2s;
    }

    .ui-typing-dot:nth-child(3) {
      animation-delay: 0.4s;
    }

    .ui-chat-ai-2 {
      animation: popInAI2 24s infinite;
    }

    .ui-chat-user-2 {
      animation: popInUser2 24s infinite;
    }

    .ui-typing-indicator-3 {
      animation: typeIndicator3 24s infinite;
    }

    .ui-chat-ai-3 {
      animation: popInAI3 24s infinite;
    }

    @keyframes fadeInMsg {
      0%, 1% { opacity: 0; transform: translateY(-10px); }
      3%, 98% { opacity: 1; transform: translateY(0); }
      100% { opacity: 0; transform: translateY(-10px); }
    }

    @keyframes typeIndicator1 {
      0%, 3% { opacity: 0; transform: translateY(10px) scale(0.95); }
      6%, 10% { opacity: 1; transform: translateY(0) scale(1); }
      12%, 100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes popInAI {
      0%, 11% { opacity: 0; transform: translateY(10px) scale(0.95); }
      13%, 98% { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes popInUser {
      0%, 20% { opacity: 0; transform: translateY(10px) scale(0.95); }
      22%, 98% { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes typeIndicator {
      0%, 25% { opacity: 0; transform: translateY(10px) scale(0.95); }
      27%, 34% { opacity: 1; transform: translateY(0) scale(1); }
      36%, 100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes typePulse {
      0%, 100% { transform: scale(1); opacity: 0.5; }
      50% { transform: scale(1.5); opacity: 1; }
    }

    @keyframes popInAI2 {
      0%, 35% { opacity: 0; transform: translateY(10px) scale(0.95); }
      37%, 98% { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes popInUser2 {
      0%, 44% { opacity: 0; transform: translateY(10px) scale(0.95); }
      46%, 98% { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }
    
    @keyframes typeIndicator3 {
      0%, 49% { opacity: 0; transform: translateY(10px) scale(0.95); }
      51%, 57% { opacity: 1; transform: translateY(0) scale(1); }
      59%, 100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes popInAI3 {
      0%, 58% { opacity: 0; transform: translateY(10px) scale(0.95); }
      60%, 98% { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }
    
    .msg-fade-call { animation: fadeCall 24s infinite ease-out !important; }
    .msg-fade-ai1 { animation: fadeAI1 24s infinite ease-out !important; }
    .msg-fade-u1 { animation: fadeUser1 24s infinite ease-out !important; }
    .msg-fade-ai2 { animation: fadeAI2 24s infinite ease-out !important; }
    .msg-fade-u2 { animation: fadeUser2 24s infinite ease-out !important; }
    .msg-fade-ai3 { animation: fadeAI3 24s infinite ease-out !important; }

    @keyframes fadeCall {
      0%, 1% { opacity: 0; transform: translateY(-10px); }
      3%, 11% { opacity: 1; transform: translateY(0); }
      13%, 20% { opacity: 0.3; transform: translateY(-7px); }
      22%, 35% { opacity: 0.15; transform: translateY(-14px); }
      37%, 98% { opacity: 0; transform: translateY(-25px); }
      100% { opacity: 0; transform: translateY(-10px); }
    }

    @keyframes fadeAI1 {
      0%, 11% { opacity: 0; transform: translateY(10px) scale(0.95); }
      13%, 20% { opacity: 1; transform: translateY(0) scale(1); }
      22%, 35% { opacity: 0.3; transform: translateY(-7px) scale(0.98); }
      37%, 44% { opacity: 0.15; transform: translateY(-14px) scale(0.95); }
      46%, 98% { opacity: 0; transform: translateY(-25px) scale(0.95); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes fadeUser1 {
      0%, 20% { opacity: 0; transform: translateY(10px) scale(0.95); }
      22%, 35% { opacity: 1; transform: translateY(0) scale(1); }
      37%, 44% { opacity: 0.3; transform: translateY(-7px) scale(0.98); }
      46%, 58% { opacity: 0.15; transform: translateY(-14px) scale(0.95); }
      60%, 98% { opacity: 0; transform: translateY(-25px) scale(0.95); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes fadeAI2 {
      0%, 35% { opacity: 0; transform: translateY(10px) scale(0.95); }
      37%, 44% { opacity: 1; transform: translateY(0) scale(1); }
      46%, 58% { opacity: 0.3; transform: translateY(-7px) scale(0.98); }
      60%, 98% { opacity: 0.15; transform: translateY(-14px) scale(0.95); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes fadeUser2 {
      0%, 44% { opacity: 0; transform: translateY(10px) scale(0.95); }
      46%, 58% { opacity: 1; transform: translateY(0) scale(1); }
      60%, 98% { opacity: 0.3; transform: translateY(-7px) scale(0.98); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    @keyframes fadeAI3 {
      0%, 58% { opacity: 0; transform: translateY(10px) scale(0.95); }
      60%, 98% { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(10px) scale(0.95); }
    }

    /* 4. Steps Process Graphic */
    .ui-steps {
      width: 100%;
      height: 100%;
      min-height: 480px;
      padding: 32px 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 16px;
      background: transparent;
      box-sizing: border-box;
    }

    .ui-task {
      display: flex;
      align-items: center;
      gap: 20px;
      background: #fff;
      padding: 24px;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      position: relative;
      animation: taskHighlight 9s infinite;
    }

    .ui-task-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94a3b8;
      font-weight: 700;
      font-size: 18px;
      flex-shrink: 0;
      animation: boxHighlight 9s infinite;
    }

    .ui-task-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .ui-task-title {
      height: 14px;
      width: 50%;
      background: #94a3b8;
      border-radius: 4px;
      animation: lineHighlight 9s infinite;
    }

    .ui-task-desc {
      height: 8px;
      width: 80%;
      background: #e2e8f0;
      border-radius: 4px;
    }

    .ui-task.t1,
    .ui-task.t1 .ui-task-icon-box,
    .ui-task.t1 .ui-task-title {
      animation-delay: 0s;
    }

    .ui-task.t2,
    .ui-task.t2 .ui-task-icon-box,
    .ui-task.t2 .ui-task-title {
      animation-delay: 3s;
    }

    .ui-task.t3,
    .ui-task.t3 .ui-task-icon-box,
    .ui-task.t3 .ui-task-title {
      animation-delay: 6s;
    }

    @keyframes taskHighlight {

      0%,
      5% {
        border-color: #e2e8f0;
        background: #fff;
        transform: scale(1);
        box-shadow: none;
      }

      10%,
      33% {
        border-color: var(--green);
        background: #fff;
        transform: scale(1.02);
        box-shadow: 0 16px 32px rgba(0, 44, 21, 0.08);
      }

      38%,
      100% {
        border-color: #e2e8f0;
        background: #fff;
        transform: scale(1);
        box-shadow: none;
      }
    }

    @keyframes boxHighlight {

      0%,
      5% {
        background: #f1f5f9;
        color: #94a3b8;
      }

      10%,
      33% {
        background: var(--dark);
        color: #fff;
      }

      38%,
      100% {
        background: #f1f5f9;
        color: #94a3b8;
      }
    }

    @keyframes lineHighlight {

      0%,
      5% {
        background: #94a3b8;
      }

      10%,
      33% {
        background: var(--dark);
      }

      38%,
      100% {
        background: #94a3b8;
      }
    }

    .ui-trades-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      padding: 24px;
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
      align-items: center;
      justify-items: center;
    }

    .ui-trade-item {
      width: 76px;
      height: 76px;
      background: #fff;
      border-radius: 20px;
      border: 1px solid #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #94a3b8;
      position: relative;
      animation: floatTrade 6s infinite ease-in-out;
    }

    .ui-trade-item:nth-child(3n + 2) {
      margin-top: 56px;
    }

    .ui-trade-item.highlight {
      background: var(--dark);
      color: var(--green);
      border-color: var(--dark);
      box-shadow: 0 16px 32px rgba(0, 44, 21, 0.15);
      z-index: 10;
      animation: floatTradeHighlight 6s infinite ease-in-out 1.0s;
    }

    .ui-trade-item:nth-child(1) {
      animation-delay: 0s;
    }

    .ui-trade-item:nth-child(2) {
      animation-delay: 0.5s;
    }

    /* 3 is highlight with its own animation-delay */
    .ui-trade-item:nth-child(4) {
      animation-delay: 1.5s;
    }

    .ui-trade-item:nth-child(5) {
      animation-delay: 2.0s;
    }

    .ui-trade-item:nth-child(6) {
      animation-delay: 2.5s;
    }

    @keyframes floatTrade {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-12px);
      }
    }

    @keyframes floatTradeHighlight {

      0%,
      100% {
        transform: translateY(0) scale(1.1);
      }

      50% {
        transform: translateY(-12px) scale(1.1);
      }
    }
`;
