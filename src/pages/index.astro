            <input class="modal-form-input" type="text" id="ai-modal-business" name="business" placeholder="Mitchell Plumbing Ltd" required>
          </div>
        </div>
        <div class="modal-form-row">
          <div class="modal-form-group">
            <label class="modal-form-label" for="ai-modal-email">Email address</label>
            <input class="modal-form-input" type="email" id="ai-modal-email" name="email" placeholder="james@mitchellplumbing.co.uk" autocomplete="email" required>
          </div>
          <div class="modal-form-group">
            <label class="modal-form-label" for="ai-modal-phone">Phone number</label>
            <input class="modal-form-input" type="tel" id="ai-modal-phone" name="phone" placeholder="+44 7700 000000" autocomplete="tel" required>
          </div>
        </div>
        <div class="modal-form-group">
          <label class="modal-form-label" for="ai-modal-comments">What would you like AI to help with? <span class="modal-form-optional">(optional)</span></label>
          <textarea class="modal-form-input modal-form-textarea" id="ai-modal-comments" name="comments" placeholder="e.g., handling missed calls, booking appointments, answering FAQs…" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg modal-form-submit">Submit Enquiry</button>
      </form>
    </div>
  </div>

  <script>
    (function () {
      // AI receptionist modal
      var aiOverlay = document.getElementById('ai-receptionist-modal');
      var aiOpenBtns = document.querySelectorAll('[id="ai-receptionist-modal-open"]');
      var aiCloseBtn = document.getElementById('ai-receptionist-modal-close');

      function openAiModal(e) {
        e.preventDefault();
        if (aiOverlay) {
          aiOverlay.classList.add('modal-overlay--open');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeAiModal() {
        if (aiOverlay) {
          aiOverlay.classList.remove('modal-overlay--open');
          document.body.style.overflow = '';
        }
      }

      // AI receptionist modal listeners
      aiOpenBtns.forEach(function(btn) {
        btn.addEventListener('click', openAiModal);
      });

      if (aiCloseBtn) {
        aiCloseBtn.addEventListener('click', closeAiModal);
      }
      if (aiOverlay) {
        aiOverlay.addEventListener('click', function (e) {
          if (e.target === aiOverlay) closeAiModal();
        });
      }

      // Escape key closes modal
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeAiModal();
        }
      });
    })();
  </script>
