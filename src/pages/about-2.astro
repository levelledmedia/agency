---
import BaseLayout from '../layouts/BaseLayout.astro';
const baseUrl = import.meta.env.BASE_URL;
const title = "About Us - Levelled Media";
const description = "We help local businesses turn more enquiries into customers using modern websites, automation, AI and local search.";
const pageStyles = `
    /* ---- About 2 — intro body under hero ---- */
    .about2-intro {
      max-width: 720px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .about2-intro p {
      font-size: 18px;
      line-height: 1.6;
      color: var(--body-text);
      margin: 0;
    }

    /* ---- Plain pain-point / question lists (not checklist — no green check) ---- */
    .plain-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 0 0 32px;
      padding: 0;
      list-style: none;
    }

    .plain-list li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      font-size: 17px;
      line-height: 1.5;
      color: var(--body-text);
    }

    .plain-list li::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--dark);
      opacity: 0.35;
      flex-shrink: 0;
      margin-top: 9px;
    }

    .detail-block--green-card .plain-list li { color: rgba(255,255,255,0.8); }
    .detail-block--green-card .plain-list li::before { background: var(--green); opacity: 1; }

    /* ---- Pull-quote style statement (bold summary lines) ---- */
    .pull-statement {
      font-size: 20px;
      line-height: 1.6;
      color: var(--dark);
      font-weight: 500;
      text-align: center;
      max-width: 760px;
      margin: 0 auto;
    }

    /* ---- Process steps (Understand -> Fix -> Automate -> Measure -> Improve) ---- */
    .process-steps {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--gap-sm);
      margin: 40px 0;
    }

    .process-step {
      text-align: center;
    }

    .process-step-num {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--green);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      font-weight: 600;
      margin: 0 auto 16px;
    }

    .process-step-label {
      font-size: 15px;
      font-weight: 600;
      color: var(--dark);
    }

    /* ---- Founder section ---- */
    .founder-section {
      background: var(--soft-bg);
      padding: var(--section-py) 0;
    }

    .founder-grid {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: var(--gap-lg);
      align-items: center;
    }

    .founder-photo {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .founder-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .founder-content .eyebrow { display: block; }

    .founder-quote {
      font-size: 20px;
      line-height: 1.6;
      color: var(--dark);
      margin: 0 0 20px;
    }

    .founder-body p {
      font-size: 17px;
      line-height: 1.6;
      color: var(--body-text);
      margin: 0 0 18px;
    }

    .founder-signature {
      margin-top: 24px;
    }

    .founder-signature-name {
      font-size: 17px;
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 2px;
    }

    .founder-signature-role {
      font-size: 15px;
      color: var(--body-text);
    }

    /* ---- Not-for-everyone comparison ---- */
    .fit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--gap-lg);
      max-width: 900px;
      margin: 40px auto 0;
    }

    .fit-card {
      background: var(--white);
      border-radius: var(--radius-card);
      padding: 36px;
      border: 1px solid rgba(0,33,43,0.08);
    }

    .fit-card-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 16px;
    }

    .fit-card p {
      font-size: 16px;
      line-height: 1.55;
      color: var(--body-text);
      margin: 0;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .founder-grid { grid-template-columns: 1fr; }
      .founder-photo { max-width: 320px; margin: 0 auto; }
      .process-steps { grid-template-columns: repeat(3, 1fr); row-gap: 32px; }
    }

    @media (max-width: 768px) {
      .fit-grid { grid-template-columns: 1fr; }
      .process-steps { grid-template-columns: repeat(2, 1fr); }
      .about2-intro p { font-size: 16px; }
      .pull-statement { font-size: 18px; }
    }
`;
---

<BaseLayout title={title} description={description} pageStyles={pageStyles}>
  <!-- ============================================================
       HERO
  ============================================================ -->
  <section class="hero-section hero-section--compact" id="hero">
    <div class="container">
      <div class="hero-inner" style="align-items: center; text-align: center;">

        <div class="hero-badge fade-up">
          <span class="badge-dot"></span>
          Our approach
        </div>

        <h1 class="hero-title fade-up">We help local businesses turn more enquiries into customers</h1>

        <p class="hero-subtitle fade-up" style="max-width: 720px; margin-left: auto; margin-right: auto;">
          Most local businesses do not need more marketing noise. They need a better system: a better website,
          faster follow-up, fewer missed opportunities, better communication, more reviews, better tracking, and a
          clearer way to turn interest into booked work.
        </p>

        <div class="about2-intro fade-up" style="margin-top: 8px; margin-bottom: 32px;">
          <p>That is what we build.</p>
          <p>Levelled Media helps local businesses improve the way they attract, manage and convert enquiries using
            modern websites, automation, AI and local search.</p>
          <p>No bloated retainers. No unnecessary complexity. No pretending that a new logo and a few social posts
            will transform your business.</p>
          <p>Just practical systems designed to help you win more of the opportunities already in front of you.</p>
        </div>

        <div class="hero-ctas fade-up">
          <a href="#" class="btn btn-primary btn-lg" id="promo-modal-open">Get a free website</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       WHY LEVELLED MEDIA EXISTS
  ============================================================ -->
  <section class="detail-section" id="why-we-exist">
    <div class="detail-block detail-block--light">
      <div class="container detail-inner">
        <div class="detail-content fade-up">
          <p class="eyebrow">Why Levelled Media exists</p>
          <h2 class="section-title">Too many good businesses are leaving money on the table</h2>
          <p class="detail-body">A lot of local businesses are excellent at the work they actually get paid to do.
            The problem is everything around it.</p>

          <ul class="plain-list">
            <li>Calls get missed.</li>
            <li>Enquiries sit unanswered.</li>
            <li>Quotes are never followed up.</li>
            <li>Old leads disappear into WhatsApp threads and spreadsheets.</li>
            <li>Review requests get forgotten.</li>
            <li>Websites look dated, load slowly or give visitors no clear reason to get in touch.</li>
          </ul>

          <p class="detail-body">And because nobody has a proper system for tracking it all, there is no easy way to
            see how much revenue is slipping through the cracks.</p>
          <p class="detail-body">We started Levelled Media because we saw how common this was. The technology to fix
            these problems already exists. What has traditionally been missing is a practical, affordable way for
            smaller businesses to actually use it. That is the gap we are here to close.</p>
        </div>
        <div class="detail-visual fade-up">
          <div class="img-placeholder img-placeholder--detail" style="height: 560px;">
            <span>Missed calls, unanswered enquiries and forgotten follow-ups add up</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       OUR APPROACH — dark card, alternate side
  ============================================================ -->
  <section class="detail-section" id="our-approach">
    <div class="detail-block detail-block--green-card">
      <div class="container detail-inner">
        <div class="detail-visual fade-up">
          <div class="img-placeholder img-placeholder--on-dark" style="height: 480px;">
            <span>Front end and back end, built together</span>
          </div>
        </div>
        <div class="detail-content fade-up">
          <p class="eyebrow">Our approach</p>
          <h2 class="section-title">Your marketing should make running the business easier</h2>
          <p class="detail-body">Marketing should not become another full-time job. It should help the right people
            find you, make it easy for them to take the next step, and give your business a reliable process for
            handling what happens next.</p>
          <p class="detail-body">That is why we think beyond the website. A website can generate an enquiry. But
            what happens if:</p>

          <ul class="plain-list">
            <li>Nobody replies?</li>
            <li>A call is missed?</li>
            <li>Someone says they need to "think about it"?</li>
            <li>An old prospect is ready to buy six months later?</li>
            <li>The job is finished and nobody asks for a review?</li>
          </ul>

          <p class="detail-body">Those small gaps add up. So we build the front end and the back end together. The
            website helps create demand and capture enquiries. The systems behind it help you respond, follow up,
            organise prospects, communicate professionally and recover opportunities that would otherwise
            disappear. That is what makes the difference.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       WHAT WE BELIEVE
  ============================================================ -->
  <section class="mission-section" id="what-we-believe">
    <div class="container">
      <div class="mission-header fade-up">
        <p class="eyebrow">What we believe</p>
        <h2 class="section-title">Better systems beat more busywork</h2>
      </div>

      <div class="mission-content-wrapper fade-up">
        <p class="mission-statement" style="text-align: left; font-size: 18px;">There is a lot of nonsense in
          marketing. Tactics get recycled for years because they still work just well enough that nobody questions
          them. Businesses get sold more traffic when they are already failing to respond to the leads they have.
          Agencies add more services, more reports and more meetings without fixing the underlying problem.</p>
        <p class="mission-statement" style="text-align: left; font-size: 18px;">We would rather keep things
          simpler.</p>
      </div>

      <div class="process-steps fade-up">
        <div class="process-step">
          <div class="process-step-num">1</div>
          <div class="process-step-label">Understand where the business is losing opportunities</div>
        </div>
        <div class="process-step">
          <div class="process-step-num">2</div>
          <div class="process-step-label">Fix the biggest gaps</div>
        </div>
        <div class="process-step">
          <div class="process-step-num">3</div>
          <div class="process-step-label">Automate what should not require manual work</div>
        </div>
        <div class="process-step">
          <div class="process-step-num">4</div>
          <div class="process-step-label">Measure what matters</div>
        </div>
        <div class="process-step">
          <div class="process-step-num">5</div>
          <div class="process-step-label">Improve from there</div>
        </div>
      </div>

      <div class="mission-content-wrapper fade-up">
        <p class="mission-statement">We are constantly learning, testing and refining the systems we use. When we
          find something that works, we standardise it and make it available to our clients.</p>
        <p class="pull-statement">The goal is not to chase every new marketing trend. It is to stay ahead without
          losing sight of what matters: more of the right enquiries, better conversion, better customer experience,
          more revenue.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       MORE THAN A WEBSITE — feature checklist grid
  ============================================================ -->
  <section class="value-section" id="more-than-a-website">
    <div class="container">
      <div class="value-header fade-up">
        <p class="eyebrow">More than a website</p>
        <h2 class="section-title">We build the system around the sale</h2>
        <p class="value-sub">A cheap website can give you something to put on a business card. That is not what we
          are interested in building. Our websites are designed around conversion from the start, with clear calls
          to action, enquiry forms, phone contact, mobile usability and messaging built around what your customers
          actually care about.</p>
      </div>

      <div class="mission-content-wrapper fade-up" style="margin-bottom: 8px;">
        <p class="mission-statement" style="text-align: left; font-size: 17px;">Then we connect the website to the
          rest of the customer journey. Depending on your plan, that can include:</p>
      </div>

      <ul class="checklist checklist--grid fade-up" style="max-width: 900px; margin: 0 auto 48px;">
        <li><span class="check-icon"></span>AI website chat that captures enquiries around the clock</li>
        <li><span class="check-icon"></span>Automatic responses to new leads</li>
        <li><span class="check-icon"></span>Missed-call text back</li>
        <li><span class="check-icon"></span>Follow-up sequences</li>
        <li><span class="check-icon"></span>Old lead reactivation</li>
        <li><span class="check-icon"></span>Online booking</li>
        <li><span class="check-icon"></span>Appointment reminders</li>
        <li><span class="check-icon"></span>Automatic review requests</li>
        <li><span class="check-icon"></span>Lead tracking and customer management</li>
        <li><span class="check-icon"></span>Unlimited website edits</li>
        <li><span class="check-icon"></span>Local SEO and Google Maps optimisation</li>
        <li><span class="check-icon"></span>Ongoing local visibility work</li>
      </ul>

      <div class="mission-content-wrapper fade-up">
        <p class="pull-statement">The point is not to add technology for the sake of it. The point is to make your
          business more responsive, more organised and easier to buy from.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       A BETTER CUSTOMER EXPERIENCE IS A BETTER BUSINESS
  ============================================================ -->
  <section class="mission-section" id="customer-experience" style="background: var(--soft-bg);">
    <div class="container">
      <div class="mission-header fade-up">
        <p class="eyebrow">Customer experience</p>
        <h2 class="section-title">A better customer experience is a better business</h2>
      </div>

      <div class="mission-content-wrapper fade-up" style="margin-bottom: 8px;">
        <p class="mission-statement" style="text-align: left; font-size: 17px;">Customers notice when a business
          has its act together.</p>
      </div>

      <ul class="checklist checklist--grid fade-up" style="max-width: 800px; margin: 0 auto 40px;">
        <li><span class="check-icon"></span>The website looks professional</li>
        <li><span class="check-icon"></span>Someone replies quickly</li>
        <li><span class="check-icon"></span>Appointments are confirmed</li>
        <li><span class="check-icon"></span>Communication is clear</li>
        <li><span class="check-icon"></span>They are followed up without having to chase</li>
      </ul>

      <div class="mission-content-wrapper fade-up">
        <p class="mission-statement">Those things may seem small individually, but together they change how a
          business feels: more established, more trustworthy, more professional, and much easier to do business
          with.</p>
        <p class="pull-statement">That is the kind of upgrade we want Levelled Media to create. Not just more
          marketing. A better business on both sides of the enquiry.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       BUILT FOR BUSINESSES THAT WANT TO MOVE FORWARD
  ============================================================ -->
  <section class="mission-section" id="who-we-fit">
    <div class="container">
      <div class="mission-header fade-up">
        <p class="eyebrow">Is this you?</p>
        <h2 class="section-title">Built for businesses that want to move forward</h2>
        <p class="value-sub" style="max-width: 720px; margin-left: auto; margin-right: auto;">We are not the right
          fit for everyone.</p>
      </div>

      <div class="fit-grid fade-up">
        <div class="fit-card">
          <p class="fit-card-title">Probably not a fit if</p>
          <p>The only goal is to spend as little as possible and keep doing things the same way, or you want a
            one-off website that sits online untouched for the next five years. There are cheaper options, and
            people who will happily build you one.</p>
        </div>
        <div class="fit-card">
          <p class="fit-card-title">We work best with</p>
          <p>Business owners who understand that better systems, better marketing and better customer experience are
            investments. You do not need to be a huge company. You do need to be willing to improve.</p>
        </div>
      </div>

      <div class="mission-content-wrapper fade-up" style="margin-top: 40px;">
        <p class="pull-statement">The businesses that pull ahead are usually not the ones doing exactly what
          everyone else is doing. They are the ones willing to build a better way of operating.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SMALL, LEAN AND HANDS-ON
  ============================================================ -->
  <section class="detail-section" id="lean-and-hands-on">
    <div class="detail-block detail-block--light">
      <div class="container detail-inner">
        <div class="detail-content fade-up">
          <p class="eyebrow">Small, lean and hands-on</p>
          <h2 class="section-title">You will not become another account number</h2>
          <p class="detail-body">Levelled Media is deliberately lean. We would rather work closely with clients,
            understand how their business actually operates and build systems around the real problems than become
            another agency where clients are passed between account managers who barely know their name.</p>
          <p class="detail-body">You get direct communication, practical advice and a team that has a genuine
            interest in whether what we build is working.</p>
          <p class="detail-body">We also try to keep the process as hands-off as possible for you. We know you have
            a business to run. Our job is to remove work where we can, not create more of it.</p>
        </div>
        <div class="detail-visual fade-up">
          <div class="img-placeholder img-placeholder--detail" style="height: 480px;">
            <span>Direct communication, no account manager hand-offs</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       A NOTE FROM THE FOUNDER
  ============================================================ -->
  <section class="founder-section" id="founder">
    <div class="container">
      <div class="founder-grid fade-up">
        <div class="founder-photo">
          <img src={baseUrl + "team/lewis-founder.jpg"} alt="Lewis, Founder of Levelled Media">
        </div>
        <div class="founder-content">
          <p class="eyebrow">A note from the founder</p>
          <h2 class="section-title">I like solving business problems</h2>

          <div class="founder-body">
            <p class="founder-quote">I started Levelled Media because marketing, sales and business have always
              fascinated me. What interests me most is the system behind the result.</p>
            <p>A business has dozens of different levers: lead generation, conversion, follow-up, customer
              experience, pricing, retention, reviews, communication and more. The challenge is working out which
              lever matters most right now, improving it, then moving onto the next. That is how I approach
              Levelled Media.</p>
            <p>I am constantly learning, experimenting and looking for better ways to solve the problems our clients
              face. Once we find something that consistently works, we turn it into a repeatable system that our
              clients can benefit from too.</p>
            <p>I have never been particularly interested in doing repetitive work simply because "that is how it
              has always been done." If something can be automated, simplified or improved, I want to find out how.
              That mindset sits behind a lot of what we build.</p>
          </div>

          <div class="founder-signature">
            <p class="founder-signature-name">Lewis, Founder</p>
            <p class="founder-signature-role">Levelled Media</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       WHAT SUCCESS LOOKS LIKE
  ============================================================ -->
  <section class="value-section" id="what-success-looks-like" style="background: var(--soft-bg);">
    <div class="container">
      <div class="value-header fade-up">
        <p class="eyebrow">What success looks like</p>
        <h2 class="section-title">A stronger system, not empty promises</h2>
        <p class="value-sub">We do not promise arbitrary numbers of leads or guarantee that you will make a specific
          amount of money. Nobody serious can honestly promise that. What we can do is give your business a
          stronger system. One that helps you:</p>
      </div>

      <ul class="checklist checklist--grid fade-up" style="max-width: 900px; margin: 0 auto 48px;">
        <li><span class="check-icon"></span>Respond faster</li>
        <li><span class="check-icon"></span>Follow up more consistently</li>
        <li><span class="check-icon"></span>Miss fewer opportunities</li>
        <li><span class="check-icon"></span>Communicate more professionally</li>
        <li><span class="check-icon"></span>Convert more of the interest you already generate</li>
        <li><span class="check-icon"></span>Build a stronger online presence</li>
        <li><span class="check-icon"></span>Reduce repetitive admin</li>
        <li><span class="check-icon"></span>Understand where your enquiries are coming from</li>
        <li><span class="check-icon"></span>Create a better experience for prospects and customers</li>
      </ul>

      <div class="mission-content-wrapper fade-up">
        <p class="pull-statement">If your business embraces those systems and uses them properly, they can
          fundamentally change the way you operate. That is the standard we aim for.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       QUESTIONS & ANSWERS
  ============================================================ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-inner fade-up">
        <div class="faq-content">
          <p class="eyebrow">Got questions?</p>
          <h2 class="section-title">Questions &amp; Answers</h2>
          <p class="faq-sub">Everything you need to know about who we are, how we work, and what it's like to be a
            client. Can't find what you're looking for? Just reach out.</p>
          <a href="/contact" class="btn btn-secondary">Contact Us</a>
        </div>

        <div class="faq-list">
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do you only work with home service businesses?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. A lot of our clients and prospects are trades and home service businesses, but the real
              requirement is simpler: you are a local business that relies on enquiries, appointments or sales
              conversations to generate revenue. If better lead handling, follow-up, online visibility and customer
              communication could improve your business, there is a good chance we can help.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Are you a website agency?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes, but that only tells part of the story. We build professional, conversion-focused websites, but we
              are much more interested in what happens before and after someone lands on the site. Our broader
              system can help capture enquiries, respond to leads, recover missed calls, follow up prospects,
              request reviews, manage appointments and track opportunities. The website is the front door. We care
              about the rest of the building too.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Can you guarantee more leads or revenue?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. There are too many variables involved in marketing, sales and running a business for anyone to
              responsibly guarantee a specific number. What we can do is improve the systems that influence those
              outcomes. We can help you become easier to find, easier to contact, faster to respond and more
              consistent in the way you follow up and communicate.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do I need to understand all the technology?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. In fact, that is partly the point. We set things up so you can benefit from modern automation and
              AI without becoming a software expert yourself. We try to keep the system simple, practical and as
              hands-off as possible.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What if I already have a website?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              That is fine. If the existing website is worth keeping, we can look at the wider marketing and sales
              system around it. If it is outdated, difficult to use or not converting well, we can replace it. The
              goal is not to rebuild things unnecessarily. The goal is to improve what is actually holding the
              business back.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What makes you different from another marketing agency?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We are less interested in selling isolated marketing services and more interested in improving the
              whole journey from discovery to sale. Generating attention is only part of the job. You also need to
              capture it, respond to it, follow it up and turn it into revenue. That is where a lot of businesses
              lose money, and it is where we put a lot of our attention.
            </div>
