---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
---

<BaseLayout
  title="Pricing — Levelled Media"
  description="Simple, transparent pricing for home service businesses. Get a free website and affordable local SEO that generates consistent inquiries."
>
  <!-- ============================================================
       HERO — PRICING
  ============================================================ -->
  <section class="hero-section hero-section--compact" id="hero">
    <div class="container hero-inner hero-inner--centered">

      <div class="hero-badge fade-up">
        <span class="badge-dot"></span>
        Simple, transparent pricing
      </div>

      <h1 class="hero-title fade-up">Start with a free website.<br>Choose your plan.</h1>

      <p class="hero-subtitle fade-up">
        No complicated tiers, no hidden fees. Get your website built free, then choose the plan that fits your business, from essential hosting to full local SEO.
      </p>

      <div class="hero-ctas fade-up">
        <button class="btn btn-primary btn-lg" id="promo-modal-open-hero">Get free website</button>
        <a href="#faq" class="btn btn-secondary btn-lg">Common questions</a>
      </div>

    </div>
  </section>

  <!-- ============================================================
       PRICING SECTION
  ============================================================ -->
  <section class="pricing-section" id="pricing">
    <div class="container">

      <div class="pricing-header text-center fade-up">
        <p class="eyebrow">Pricing</p>
        <h2 class="section-title">Start free. Grow monthly.</h2>
        <p class="pricing-sub">Your website is built at no upfront cost. All you pay is a flat monthly retainer that covers hosting, SEO, updates, and ongoing optimisation.</p>
      </div>

      <div class="pricing-grid fade-up">

        <!-- Website Card (Free) -->
        <div class="plan-card plan-card--light">
          <div class="plan-card-top">
            <p class="plan-label">Website</p>
            <div class="plan-price">
              <span class="plan-price-amount">FREE</span>
            </div>
            <p class="plan-desc">A professionally designed, conversion-focused website built for your business at no cost.</p>
          </div>
          <ul class="plan-features">
            <li><span class="check-icon"></span>Custom design tailored to your trade</li>
            <li><span class="check-icon"></span>Mobile-first and fast-loading</li>
            <li><span class="check-icon"></span>Service &amp; location pages included</li>
            <li><span class="check-icon"></span>Contact forms and click-to-call buttons</li>
            <li><span class="check-icon"></span>You own it outright</li>
          </ul>
          <button class="btn btn-secondary btn-lg plan-cta" id="promo-modal-open">Request free website</button>
        </div>

        <!-- Google Booster Card (Featured) -->
        <div class="plan-card plan-card--featured">
          <div class="plan-badge-tag">Recommended</div>
          <div class="plan-card-top">
            <p class="plan-label">Google Booster</p>
            <div class="plan-price">
              <span class="plan-price-amount">£299</span>
              <span class="plan-price-term">/ month</span>
            </div>
            <p class="plan-desc">Everything you need to rank locally, generate inquiries, and keep your online presence performing.</p>
          </div>
          <ul class="plan-features">
            <li><span class="check-icon"></span>Everything in Essentials</li>
            <li><span class="check-icon"></span>Local SEO &amp; Google Maps optimisation</li>
            <li><span class="check-icon"></span>Monthly content &amp; page updates</li>
            <li><span class="check-icon"></span>Google Business Profile management</li>
            <li><span class="check-icon"></span>Monthly performance reporting</li>
            <li><span class="check-icon"></span>Priority support</li>
          </ul>
          <a href="#" class="btn btn-primary btn-lg plan-cta">Get started</a>
        </div>

        <!-- Essentials Card -->
        <div class="plan-card plan-card--light">
          <div class="plan-card-top">
            <p class="plan-label">Essentials</p>
            <div class="plan-price">
              <span class="plan-price-amount">£49</span>
              <span class="plan-price-term">/ month</span>
            </div>
            <p class="plan-desc">Keep your website live with professional hosting, maintenance, and essential support.</p>
          </div>
          <ul class="plan-features">
            <li><span class="check-icon"></span>Website hosting &amp; security</li>
            <li><span class="check-icon"></span>Technical maintenance &amp; updates</li>
            <li><span class="check-icon"></span>Performance monitoring</li>
            <li><span class="check-icon"></span>Email support</li>
          </ul>
          <a href="#" class="btn btn-secondary btn-lg plan-cta">Get started</a>
        </div>

      </div>

      <!-- Trust note -->
      <p class="pricing-trust fade-up">No contracts. Cancel anytime. Results-focused from day one.</p>

    </div>
  </section>

  <!-- ============================================================
       PRICING FAQ
  ============================================================ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-inner fade-up">
        <div class="faq-content">
          <p class="eyebrow">Pricing questions</p>
          <h2 class="section-title">Questions &amp;<br>Answers</h2>
          <p class="faq-sub">Everything you need to know about what's included, how billing works, and what to expect. Still unsure? Reach out to our team anytime.</p>
          <a href="#" class="btn btn-secondary">Contact Us</a>
        </div>

        <div class="faq-list">
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Is the free website really free?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes. We design and build your website at no upfront cost with no obligation to keep it. Once it's ready, you can decide whether to move forward. If you do, you'll choose either the Essentials or Google Booster plan and commit to a minimum of 12 months.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What's the difference between Essentials and Google Booster?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Essentials (£49/month) covers website hosting, security, technical maintenance, and email support. Google Booster (£299/month) includes everything in Essentials plus local SEO, Google Maps optimisation, monthly content updates, Google Business Profile management, performance reporting, and priority support.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What happens after the 12-month commitment?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              After 12 months, you can continue with us on a rolling monthly basis, cancel with 30 days' notice, or take your website elsewhere. If you choose to leave, we'll help you migrate your website and transfer everything to you (the domain, files, and content).
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do I own my website?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes. Once your website is live, you own it outright. We don't lock you into proprietary platforms. Your site is yours to keep, and we'll help you take it with you if you decide to leave after your commitment period.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Can I switch between plans?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes. You can upgrade from Essentials to Google Booster at any time. If you want to downgrade, just give us 30 days' notice and we'll adjust your plan accordingly.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              How soon will I see results with Google Booster?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Your website will go live within 2 to 3 weeks of your initial call. SEO improvements build over time, and most clients start seeing meaningful ranking and traffic gains within 3 to 6 months.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 5B — AUTO-SCROLL TESTIMONIAL CAROUSEL
  ============================================================ -->
  <TestimonialsSection />

  <!-- ============================================================
       PRE-FOOTER CTA
  ============================================================ -->
  <section class="final-cta-section">
    <div class="container text-center fade-up">
      <h2 class="section-title">Ready to get started?</h2>
      <p class="final-cta-sub">Get your free website and start generating more local inquiries today.</p>
      <button class="btn btn-primary btn-xl" id="promo-modal-open-footer">Request my free website</button>
    </div>
  </section>

  <!-- ============================================================
       FREE WEBSITE MODAL
  ============================================================ -->
  <div class="modal-overlay" id="promo-modal" aria-modal="true" role="dialog" aria-labelledby="modal-title">
    <div class="modal-card">
      <button class="modal-close" id="promo-modal-close" aria-label="Close">&#x2715;</button>
      <form class="modal-form" action="#" method="post">
        <div class="modal-form-row">
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-name">Your name</label>
            <input class="modal-form-input" type="text" id="modal-name" name="name" placeholder="James Mitchell" autocomplete="name" required>
          </div>
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-business">Business name</label>
            <input class="modal-form-input" type="text" id="modal-business" name="business" placeholder="Mitchell Plumbing Ltd" required>
          </div>
        </div>
        <div class="modal-form-row">
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-email">Email address</label>
            <input class="modal-form-input" type="email" id="modal-email" name="email" placeholder="james@mitchellplumbing.co.uk" autocomplete="email" required>
          </div>
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-phone">Phone number</label>
            <input class="modal-form-input" type="tel" id="modal-phone" name="phone" placeholder="+44 7700 000000" autocomplete="tel" required>
          </div>
        </div>
        <div class="modal-form-group">
          <label class="modal-form-label" for="modal-website">Current website <span class="modal-form-optional">(optional)</span></label>
          <input class="modal-form-input" type="url" id="modal-website" name="website" placeholder="https://www.example.co.uk">
        </div>
        <div class="modal-form-group">
          <label class="modal-form-label" for="modal-comments">Anything else we should know? <span class="modal-form-optional">(optional)</span></label>
          <textarea class="modal-form-input modal-form-textarea" id="modal-comments" name="comments" placeholder="Tell us about your business, the areas you cover, any inspiration, or links we should look at before designing your site…" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg modal-form-submit">Request My Free Website</button>
      </form>
    </div>
  </div>

  <script>
    (function () {
      var overlay = document.getElementById('promo-modal');
      var openBtns = [
        document.getElementById('promo-modal-open'),
        document.getElementById('promo-modal-open-hero'),
        document.getElementById('promo-modal-open-footer')
      ];
      var closeBtn = document.getElementById('promo-modal-close');

      function openModal() {
        overlay.classList.add('modal-overlay--open');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        overlay.classList.remove('modal-overlay--open');
        document.body.style.overflow = '';
      }

      openBtns.forEach(function(btn) {
        if (btn) {
          btn.addEventListener('click', openModal);
        }
      });

      closeBtn.addEventListener('click', closeModal);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeModal();
      });
    })();
  </script>
</BaseLayout>
