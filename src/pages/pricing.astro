---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
---

<BaseLayout
  title="Pricing — Levelled Media"
  description="Simple, transparent pricing for local businesses. £0 upfront, then a flat monthly plan that grows with you, from a professional website to full local SEO."
>
  <!-- ============================================================
       HERO — PRICING
  ============================================================ -->
  <section class="hero-section hero-section--compact" id="hero">
    <div class="container hero-inner hero-inner--centered">

      <div class="hero-badge fade-up">
        <span class="badge-dot"></span>
        Simple, transparent pricing
      </div>

      <h1 class="hero-title fade-up">Pricing that grows with your business</h1>

      <p class="hero-subtitle fade-up">
        No contracts, no hidden costs. Just a simple monthly plan that includes everything you need to bring in more customers.
      </p>

      <div class="hero-ctas fade-up">
        <a href="/call" class="btn btn-primary btn-lg">Book a Call</a>
        <a href="#faq" class="btn btn-secondary btn-lg">Common questions</a>
      </div>

    </div>
  </section>

  <!-- ============================================================
       PRICING SECTION
  ============================================================ -->
  <section class="pricing-section" id="pricing">
    <div class="container">

      <div class="pricing-header text-center fade-up">
        <p class="eyebrow">Pricing</p>
        <h2 class="section-title">£0 upfront. Grow monthly.</h2>
        <p class="pricing-sub">No hidden fees, no long contracts. Start capturing enquiries from day one, then add automation and local SEO as your business grows.</p>
      </div>

      <div class="pricing-grid fade-up">

        <!-- Starter Card -->
        <div class="plan-card plan-card--light">
          <div class="plan-card-top">
            <p class="plan-label">Starter</p>
            <div class="plan-price">
              <span class="plan-price-amount">£65</span>
              <span class="plan-price-term">/ month</span>
            </div>
            <p class="plan-desc">Everything you need to start capturing enquiries online.</p>
          </div>
          <ul class="plan-features">
            <li><span class="check-icon"></span>Professional website</li>
            <li><span class="check-icon"></span>Built to capture enquiries</li>
            <li><span class="check-icon"></span>AI chatbot for enquiries 24/7</li>
            <li><span class="check-icon"></span>All leads sent to your phone</li>
            <li><span class="check-icon"></span>Unlimited website edits</li>
          </ul>
          <a href="/call" class="btn btn-secondary btn-lg plan-cta">Book a Call</a>
        </div>

        <!-- Growth Card (Featured) -->
        <div class="plan-card plan-card--featured">
          <div class="plan-badge-tag">Recommended</div>
          <div class="plan-card-top">
            <p class="plan-label">Growth</p>
            <div class="plan-price">
              <span class="plan-price-amount">£199</span>
              <span class="plan-price-term">/ month</span>
            </div>
            <p class="plan-desc">Automate the busywork so no enquiry slips through the cracks.</p>
          </div>
          <ul class="plan-features">
            <li><span class="check-icon"></span>Everything in Starter, plus:</li>
            <li><span class="check-icon"></span>Reply to enquiries automatically</li>
            <li><span class="check-icon"></span>Revive old leads automatically</li>
            <li><span class="check-icon"></span>Win back missed-call leads</li>
            <li><span class="check-icon"></span>Ask for reviews automatically</li>
            <li><span class="check-icon"></span>Send automatic visit reminders</li>
            <li><span class="check-icon"></span>Weekly social posts done for you</li>
          </ul>
          <a href="/call" class="btn btn-primary btn-lg plan-cta">Book a Call</a>
        </div>

        <!-- Professional Card -->
        <div class="plan-card plan-card--light">
          <div class="plan-card-top">
            <p class="plan-label">Professional</p>
            <div class="plan-price">
              <span class="plan-price-amount" style="font-size: 34px;">Let's talk</span>
            </div>
            <p class="plan-desc">Get found first, everywhere your customers are searching.</p>
          </div>
          <ul class="plan-features">
            <li><span class="check-icon"></span>Everything else, plus:</li>
            <li><span class="check-icon"></span>Show up higher on Google</li>
            <li><span class="check-icon"></span>Rank higher on Google Maps</li>
            <li><span class="check-icon"></span>Get listed on trusted local sites</li>
            <li><span class="check-icon"></span>Get recommended by ChatGPT</li>
            <li><span class="check-icon"></span>Generate more local leads</li>
          </ul>
          <a href="/call" class="btn btn-secondary btn-lg plan-cta">Book a Call</a>
        </div>

      </div>

      <!-- Trust note -->
      <p class="pricing-trust fade-up">No contracts. Cancel anytime. Results-focused from day one.</p>

    </div>
  </section>

  <!-- ============================================================
       PRICING FAQ
  ============================================================ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-inner fade-up">
        <div class="faq-content">
          <p class="eyebrow">Pricing questions</p>
          <h2 class="section-title">Questions &amp; Answers</h2>
          <p class="faq-sub">Everything you need to know about what's included, how billing works, and what to expect. Still unsure? Reach out to our team anytime.</p>
          <a href="#" class="btn btn-secondary">Contact Us</a>
        </div>

        <div class="faq-list">
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Is there really no upfront cost?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              That's right. We build and launch your website with no big upfront bill. You just pay one flat
              monthly rate depending on the plan you choose, and you're up and running.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What's the difference between the plans?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Starter (£65/month) gets you a professional website built to capture enquiries, with an AI chatbot
              and every lead sent straight to your phone. Growth (£199/month) adds automation on top, so old leads
              get revived, missed calls get followed up, and reviews get requested without you lifting a finger.
              Professional layers on local SEO, so you show up higher on Google, Google Maps, and even AI tools
              like ChatGPT.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Can I cancel anytime?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes. There are no long contracts. If a plan isn't working for you, you can cancel anytime.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do I own my website?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes. Once your website is live, it's yours. We don't lock you into proprietary platforms, and if you
              ever decide to leave, we'll help you take it with you.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              How soon will I see results with the Professional plan?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Your website goes live within three to five business days of your first call. Local SEO builds over
              time, and most clients start seeing meaningful ranking and lead gains within 3 to 6 months.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Which plan is right for me?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              If you just need a professional website that captures enquiries, Starter has you covered. If you're
              tired of chasing leads and want the follow-up handled for you, Growth is the natural next step. And if
              ranking higher on Google and Google Maps is the priority, Professional is built for that. Not sure?
              Book a call and we'll help you figure out what fits.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Is there a setup or joining fee?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. £0 upfront means exactly that. You only pay the flat monthly rate for the plan you choose, with
              no separate setup, onboarding or joining costs.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 5B — AUTO-SCROLL TESTIMONIAL CAROUSEL
  ============================================================ -->
  <TestimonialsSection />

  <!-- ============================================================
       PRE-FOOTER CTA
  ============================================================ -->
  <section class="final-cta-section">
    <div class="container text-center fade-up">
      <h2 class="section-title">Ready to get started?</h2>
      <p class="final-cta-sub">Book a quick call and we'll show you how to bring in more customers online, starting with a plan built around your business.</p>
      <a href="/call" class="btn btn-primary btn-xl">Book a quick call</a>
    </div>
  </section>
</BaseLayout>
