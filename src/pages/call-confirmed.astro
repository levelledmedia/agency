---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Booking Confirmed — Levelled Media"
  description="Your call has been booked with Levelled Media."
  minimalHeader={true}
  hideFooter={true}
  disableLogoLink={true}
  pageStyles={`
    .nav-header {
      position: static !important;
      top: auto !important;
      box-shadow: none !important;
      border-bottom: none !important;
      transition: none !important;
    }

    .nav-header--minimal .nav-inner {
      justify-content: center;
    }

    .nav-header.scrolled {
      position: static !important;
      box-shadow: none !important;
      border-bottom: none !important;
      background: var(--dark);
    }

    .success-section {
      padding: 56px 0 96px;
    }

    .success-panel-wrap {
      max-width: none;
      width: 100%;
      padding-left: 16px;
      padding-right: 16px;
    }

    .success-panel {
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
      background: var(--white);
      border: 1px solid rgba(0,33,43,0.08);
      border-radius: 28px;
      box-shadow: var(--shadow-mock);
      padding: 56px 40px;
      text-align: center;
    }

    .success-panel .success-title {
      color: var(--dark);
      font-size: 40px;
      margin: 0 auto 16px;
      max-width: 680px;
    }

    .success-copy {
      max-width: 620px;
      margin: 0 auto;
      font-size: 18px;
      line-height: 1.7;
      color: var(--body-text);
    }

    @media (max-width: 768px) {
      .success-section {
        padding: 40px 0 72px;
      }

      .success-panel {
        padding: 40px 24px;
      }

      .success-panel .success-title {
        font-size: 30px;
      }

      .success-copy {
        font-size: 16px;
      }
    }
  `}
>
  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1948982362464155');
    fbq('track', 'Lead');
    fbq('track', 'Schedule');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1948982362464155&ev=Lead&noscript=1"
  /></noscript>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1948982362464155&ev=Schedule&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->

  <section class="success-section">
    <div class="container success-panel-wrap">
      <div class="success-panel fade-up">
        <h1 class="hero-title success-title">Call booked.</h1>
        <p class="success-copy">
          Your booking is confirmed. We’ll call you at the time you selected.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
