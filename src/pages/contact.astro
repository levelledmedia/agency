---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
---

<BaseLayout
  title="Contact — Levelled Media"
  description="Get in touch with Levelled Media. We're here to help home service businesses grow through high-converting websites and local SEO."
>
  <!-- ============================================================
       HERO — CONTACT
  ============================================================ -->
  <section class="hero-section hero-section--compact" id="hero">
    <div class="container hero-inner hero-inner--centered">

      <div class="hero-badge fade-up">
        <span class="badge-dot"></span>
        Let's talk
      </div>

      <h1 class="hero-title fade-up">Get in touch</h1>

      <p class="hero-subtitle fade-up">
        Ready to improve your website and local visibility? Fill in the form below and we'll get back to you within one business day.
      </p>

    </div>
  </section>

  <!-- ============================================================
       CONTACT FORM SECTION
  ============================================================ -->
  <section class="pricing-section" id="contact-form">
    <div class="container">

      <div class="pricing-header text-center fade-up">
        <p class="eyebrow">Contact Form</p>
        <h2 class="section-title">How can we help?</h2>
        <p class="pricing-sub">Whether you need a new website, want to improve your local search rankings, or have a question about our services, we're here to help.</p>
      </div>

      <div class="contact-form-container fade-up">
        <form class="contact-form" action="#" method="post">
          <div class="contact-form-row">
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-name">Your name</label>
              <input class="contact-form-input" type="text" id="contact-name" name="name" placeholder="James Mitchell" autocomplete="name" required>
            </div>
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-business">Business name</label>
              <input class="contact-form-input" type="text" id="contact-business" name="business" placeholder="Mitchell Plumbing Ltd" required>
            </div>
          </div>
          <div class="contact-form-row">
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-email">Email address</label>
              <input class="contact-form-input" type="email" id="contact-email" name="email" placeholder="james@mitchellplumbing.co.uk" autocomplete="email" required>
            </div>
            <div class="contact-form-group">
              <label class="contact-form-label" for="contact-phone">Phone number</label>
              <input class="contact-form-input" type="tel" id="contact-phone" name="phone" placeholder="+44 7700 000000" autocomplete="tel" required>
            </div>
          </div>
          <div class="contact-form-group">
            <label class="contact-form-label" for="contact-website">Current website <span class="contact-form-optional">(optional)</span></label>
            <input class="contact-form-input" type="url" id="contact-website" name="website" placeholder="https://www.example.co.uk">
          </div>
          <div class="contact-form-group">
            <label class="contact-form-label" for="contact-message">How can we help? <span class="contact-form-optional">(optional)</span></label>
            <textarea class="contact-form-input contact-form-textarea" id="contact-message" name="message" placeholder="Tell us what you're looking for: a new website, SEO help, or just want to learn more…" rows="5"></textarea>
          </div>
          <div class="contact-form-submit-wrapper">
            <button type="submit" class="btn btn-primary btn-lg contact-form-submit">Send Message</button>
          </div>
        </form>
      </div>

    </div>
  </section>

  <!-- ============================================================
       CONTACT FAQ
  ============================================================ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-inner fade-up">
        <div class="faq-content">
          <p class="eyebrow">Contact questions</p>
          <h2 class="section-title">Questions &amp;<br>Answers</h2>
          <p class="faq-sub">Common questions about getting in touch, response times, and what happens next.</p>
        </div>

        <div class="faq-list">
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              How quickly will I hear back?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We aim to respond to all enquiries within one business day. If you submit your form outside of office hours, we'll get back to you first thing the next working day.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What happens after I submit the form?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Once we receive your enquiry, we'll review your details and get back to you via email or phone to discuss your needs and how we can help. There's no obligation, it's just a conversation.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do you offer free consultations?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Yes. We offer a free initial consultation where we'll discuss your business, your current online presence, and what opportunities exist to improve your website and local visibility.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Can I book a call instead of filling in the form?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Absolutely. If you'd prefer to speak directly, just mention that in the message field and we'll send you a calendar link to book a time that works for you.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What areas do you cover?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              We're based in Essex but work with home service businesses across the UK. Location is no barrier, and we've helped tradespeople from Scotland to the South Coast.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Will I be locked into a contract?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No. We don't believe in locking people in. Our agreements are straightforward, and we'd rather earn your continued business through results than through small print.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              What information should I prepare before getting in touch?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Just your business name, contact details, and a brief idea of what you're looking for. If you have a current website, it's helpful to share the URL, but it's not required.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Do you work with businesses outside the UK?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              Our primary focus is the UK market, where we have the deepest knowledge of local search behaviour and competition. That said, we're open to conversations with trades businesses in similar English-speaking markets.
            </div>
          </div>
          <div class="accordion-item" data-accordion>
            <button class="accordion-trigger">
              Is there a cost for the initial consultation?
              <span class="accordion-icon"></span>
            </button>
            <div class="accordion-body">
              No, the initial consultation is completely free. We'll discuss your business, review your current situation, and identify opportunities with no obligation to proceed.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION 5B — AUTO-SCROLL TESTIMONIAL CAROUSEL
  ============================================================ -->
  <TestimonialsSection />

  <!-- ============================================================
       PRE-FOOTER CTA
  ============================================================ -->
  <section class="final-cta-section">
    <div class="container text-center fade-up">
      <h2 class="section-title">Ready to get started?</h2>
      <p class="final-cta-sub">Get your free website and start generating more local inquiries today.</p>
      <button class="btn btn-primary btn-xl" id="promo-modal-open-footer">Request my free website</button>
    </div>
  </section>

  <!-- ============================================================
       FREE WEBSITE MODAL
  ============================================================ -->
  <div class="modal-overlay" id="promo-modal" aria-modal="true" role="dialog" aria-labelledby="modal-title">
    <div class="modal-card">
      <button class="modal-close" id="promo-modal-close" aria-label="Close">&#x2715;</button>
      <form class="modal-form" action="#" method="post">
        <div class="modal-form-row">
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-name">Your name</label>
            <input class="modal-form-input" type="text" id="modal-name" name="name" placeholder="James Mitchell" autocomplete="name" required>
          </div>
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-business">Business name</label>
            <input class="modal-form-input" type="text" id="modal-business" name="business" placeholder="Mitchell Plumbing Ltd" required>
          </div>
        </div>
        <div class="modal-form-row">
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-email">Email address</label>
            <input class="modal-form-input" type="email" id="modal-email" name="email" placeholder="james@mitchellplumbing.co.uk" autocomplete="email" required>
          </div>
          <div class="modal-form-group">
            <label class="modal-form-label" for="modal-phone">Phone number</label>
            <input class="modal-form-input" type="tel" id="modal-phone" name="phone" placeholder="+44 7700 000000" autocomplete="tel" required>
          </div>
        </div>
        <div class="modal-form-group">
          <label class="modal-form-label" for="modal-website">Current website <span class="modal-form-optional">(optional)</span></label>
          <input class="modal-form-input" type="url" id="modal-website" name="website" placeholder="https://www.example.co.uk">
        </div>
        <div class="modal-form-group">
          <label class="modal-form-label" for="modal-comments">Anything else we should know? <span class="modal-form-optional">(optional)</span></label>
          <textarea class="modal-form-input modal-form-textarea" id="modal-comments" name="comments" placeholder="Tell us about your business, the areas you cover, any inspiration, or links we should look at before designing your site…" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg modal-form-submit">Request My Free Website</button>
      </form>
    </div>
  </div>

  <script>
    (function () {
      var overlay = document.getElementById('promo-modal');
      var openBtns = [
        document.getElementById('promo-modal-open-footer')
      ];
      var closeBtn = document.getElementById('promo-modal-close');

      function openModal() {
        overlay.classList.add('modal-overlay--open');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        overlay.classList.remove('modal-overlay--open');
        document.body.style.overflow = '';
      }

      openBtns.forEach(function(btn) {
        if (btn) {
          btn.addEventListener('click', openModal);
        }
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', closeModal);
      }
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeModal();
      });
    })();
  </script>
</BaseLayout>
